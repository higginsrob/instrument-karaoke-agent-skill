# NVIDIA GPU media-pipeline image (DGX Spark / CUDA hosts)
ARG NGC_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.06-py3
FROM mwader/static-ffmpeg:7.0.2 AS ffmpeg_bin
FROM ${NGC_PYTORCH_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    TORCH_HOME=/data/models \
    JOBS_DIR=/data/jobs \
    LIBRARY_DIR=/library \
    PORT=8093 \
    DEMUCS_DEVICE=cuda \
    ADTOF_DEVICE=cuda \
    ALIGN_DEVICE=cuda \
    PYTHONPATH=/app/server/shims

WORKDIR /app

USER 0

COPY --from=ffmpeg_bin --chmod=755 /ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg_bin --chmod=755 /ffprobe /usr/local/bin/ffprobe

# Deno solves YouTube JS challenges for yt-dlp (EJS). Without it only storyboards are available.
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && deno --version

COPY requirements.txt /app/requirements.txt

# Pin the NGC CUDA torch stack; never replace prebuilt torch wheels from PyPI.
RUN python3 <<'PY'
import importlib.util
import pathlib
import torch

lines = [f"torch=={torch.__version__}"]
if importlib.util.find_spec("torchaudio"):
    import torchaudio
    lines.append(f"torchaudio=={torchaudio.__version__}")
pathlib.Path("/tmp/constraints.txt").write_text("\n".join(lines) + "\n")
print(pathlib.Path("/tmp/constraints.txt").read_text())
PY

RUN python3 -m pip install --no-cache-dir -c /tmp/constraints.txt -r /app/requirements.txt

RUN python3 -m pip install --no-cache-dir -c /tmp/constraints.txt --no-deps "demucs==4.0.1"

# dora-search runtime deps (install_requires); keep --no-deps to avoid torch churn.
RUN python3 -m pip install --no-cache-dir -c /tmp/constraints.txt --no-deps \
    dora-search einops julius lameenc openunmix pyyaml tqdm \
    omegaconf retrying submitit cloudpickle treetable

RUN python3 -m pip install --no-cache-dir -c /tmp/constraints.txt --no-deps \
    git+https://github.com/xavriley/ADTOF-pytorch.git

RUN python3 -m pip install --no-cache-dir -c /tmp/constraints.txt pretty_midi

COPY server /app/server

# Prefer shim when NGC aarch64 lacks ABI-matched torchaudio.
RUN python3 <<'PY'
import torch
import torchaudio
import demucs.separate
from adtof_pytorch import get_default_weights_path

print("torch", torch.__version__, "cuda", torch.cuda.is_available())
print("torchaudio", getattr(torchaudio, "__file__", "?"))
print("demucs ok")
print("adtof weights", get_default_weights_path())
PY

RUN mkdir -p /data/jobs /data/models /library

EXPOSE 8093
VOLUME ["/data/jobs", "/data/models", "/library"]

CMD ["python3", "-m", "uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8093", "--workers", "1"]
